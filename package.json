{
  "name": "coderwhoclothes-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-articles.mjs && vite build && node scripts/build-collections.mjs && node scripts/render-home.mjs",
    "preview": "vite preview",
    "build:preview": "node scripts/sync-articles.mjs && vite build && node scripts/build-collections.mjs --drafts && node scripts/render-home.mjs --drafts",
    "preview:collections": "npm run build:preview && vite preview --host 0.0.0.0",
    "sync:articles": "node scripts/sync-articles.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^3.1.0",
    "vite": "^4.1.0"
  }
}
